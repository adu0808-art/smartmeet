# SmartMeet 환경변수 템플릿
#   - 로컬 개발 시 .env 로 복사 후 값 수정
#   - Railway 배포 시 Variables 탭에서 설정

# ▶ 서버 포트 (Railway 자동 주입 — 수동 설정 불필요)
PORT=3030

# ▶ JWT 시크릿 — 반드시 길고 랜덤한 값으로 변경 (배포 환경)
#   생성 예: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# ▶ DB 저장 경로 (Railway Volume 마운트 경로)
#   배포: /data
#   로컬: 비워두면 ./DB 사용
DB_DIR=/data
